{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Sid":  "ListDemoPrefix",
                          "Resource":  "arn:aws:s3:::geetha-emr-rdd-314993330933-20260717214708",
                          "Condition":  {
                                            "StringLike":  {
                                                               "s3:prefix":  [
                                                                                 "rdd-demo",
                                                                                 "rdd-demo/*"
                                                                             ]
                                                           }
                                        },
                          "Action":  [
                                         "s3:GetBucketLocation",
                                         "s3:ListBucket",
                                         "s3:ListBucketMultipartUploads"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "ReadWriteDemoObjects",
                          "Resource":  "arn:aws:s3:::geetha-emr-rdd-314993330933-20260717214708/rdd-demo/*",
                          "Action":  [
                                         "s3:GetObject",
                                         "s3:GetObjectVersion",
                                         "s3:PutObject",
                                         "s3:DeleteObject",
                                         "s3:AbortMultipartUpload",
                                         "s3:ListMultipartUploadParts"
                                     ]
                      }
                  ]
}